# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# AI Provider Configuration
# Options: "mock" (default, deterministic local test mock) or "gemini" (Google Gemini Developer API)
AI_PROVIDER=mock

# Google Gemini API Configuration (Required when AI_PROVIDER=gemini)
# Acquire a free API key with zero billing from Google AI Studio: https://aistudio.google.com/apikey
# NEVER commit your real API key to source control.
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Identifier (Free-tier eligible model: gemini-2.5-flash)
# Default: gemini-2.5-flash (Free of charge, ₹0 cost)
GEMINI_MODEL=gemini-2.5-flash

# SQLite Database Configuration
# Default: data/atlas.db (stable absolute path inside backend package)
# For in-memory testing or isolated runs: :memory:
SQLITE_DB_PATH=data/atlas.db
